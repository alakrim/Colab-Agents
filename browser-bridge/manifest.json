{
  "manifest_version": 3,
  "name": "Agent Company OS — Subscription Bridge",
  "version": "0.1.0",
  "description": "Connects your authenticated Claude.ai and Gemini.google.com browser tabs to your self-hosted Agent Company OS workspace.",
  "permissions": ["tabs", "storage", "scripting"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*", "https://gemini.google.com/*"],
      "js": ["content-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Agent Company OS Bridge"
  }
}
